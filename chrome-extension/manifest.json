{
  "manifest_version": 3,
  "name": "Notification Manager",
  "version": "0.2.4",
  "description": "Past events from your primary Google Calendar in a dedicated window.",
  "minimum_chrome_version": "105",
  "permissions": ["identity", "storage", "tabs", "windows", "system.display"],
  "host_permissions": ["https://www.googleapis.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Open Notification Manager" },
  "oauth2": {
    "client_id": "411250810503-a8q4f7v7vnvh8o9djfejke6h2g95c4j8.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/calendar.readonly",
      "https://www.googleapis.com/auth/calendar.events",
      "https://www.googleapis.com/auth/drive.appdata"
    ]
  },
  "key": ""
}
